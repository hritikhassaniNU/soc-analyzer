# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

# --- Postgres container (docker-compose uses these to create the database) ---
POSTGRES_USER=soc
POSTGRES_PASSWORD=soc_dev_password   # demo only; change for any shared/deployed setup
POSTGRES_DB=soc

# --- Backend: connection used when running the app on your machine (outside Docker) ---
# Inside Docker Compose the host is `db`, not `localhost`; compose overrides this for the api service.
# Port 5433 = the host port docker-compose publishes for the db container.
DATABASE_URL=postgresql+psycopg://soc:soc_dev_password@localhost:5433/soc

# --- Seeded analyst accounts (no sign-up page). Format: user1:pass1,user2:pass2 ---
# Passwords: 8+ chars, no ',' or ':'. CHANGE before deploying publicly.
SEED_USERS=analyst:ChangeMe-Demo-123
